<div{{ attributes }}>

        <div class="d-flex my-3 px-3 py-2 border justify-content-between align-items-center shadow-sm">
            <div class="d-flex align-items-center">
                <div class="me-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="2em" height="2em" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M8.293 14.293a1 1 0 1 1 1.414 1.414l-4 4a1 1 0 0 1-1.414 0l-2-2a1
                        1 0 1 1 1.414-1.414L5 17.586zM21 18a1 1 0 1 1 0 2h-8a1 1 0 1 1 0-2zm0-7a1 1 0 1 1 0 2h-8a1 1 0
                        1 1 0-2zM8 3a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm13 1a1 1 0 1 1 0 2h
                        -8a1 1 0 1 1 0-2z"/>
                    </svg>
                </div>
                <div class="fw-bold fs-4">Task Manager</div>
            </div>

            <div class="d-flex align-items-center">
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <div class="d-flex align-items-center me-3">
                        <div>
                            <svg xmlns="http://www.w3.org/2000/svg" width="2em" height="2em" viewBox="0 0 24 24">
                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                      stroke-width="2" d="M21 22c-.57-11.852-17.43-11.852-18 0M17.625 7.556a5.52 5.52 0
                                  0 1-1.648 3.928A5.66 5.66 0 0 1 12 13.11a5.66 5.66 0 0 1-3.977-1.627a5.52 5.52 0 0
                                  1-1.648-3.928c0-1.474.593-2.887 1.648-3.929A5.66 5.66 0 0 1 12 2c1.492 0 2.923.585
                                  3.977 1.627a5.52 5.52 0 0 1 1.648 3.929"/>
                            </svg>
                        </div>
                        <div>{{ app.user.firstName }} {{ app.user.lastName }}</div></div>
                    <div>
                        <form action="{{ logout_path() }}" method="POST" style="display: inline;">
                            <!-- Si vous utilisez la protection CSRF sur le logout, Symfony l'attend ici -->
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">

                            <button type="submit" style="background: none; border: none; padding: 0; cursor: pointer;">
                                <svg xmlns="http://w3.org" width="2em" height="2em" viewBox="0 0 24 24">
                                    <path fill="black" d="M5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h7v2H5v14h7v2zm11-4l-1.375-1.45l2.55-2.55H9v-2h8.175l-2.55-2.55L16 7l5 5z"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                {% endif %}
            </div>

        </div>

</div>
