<div{{ attributes }}>
    <label for="search-bar">Rechercher</label>
    <input type="search" data-model="keyWord" name="search-bar">

    <select data-model="sortMode">
        <option value="created_desc">Du plus récent au plus ancien</option>
        <option value="created_asc">Du plus ancien au plus récent</option>
        <option value="deadline_desc">Du plus urgent au moins urgent</option>
        <option value="deadline_asc">Du moins urgent au plus urgent</option>
    </select>

    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>Titre</th>
            <th>Details</th>
            <th>Date de creation</th>
            <th>Date limite</th>
            <th>Actions</th>
            <th>Terminer</th>
        </tr>
        </thead>
        <tbody>
        {% for task in this.tasksByCriteria %}
            <tr>
                <td>{{ task.id }}</td>
                <td>{{ task.title }}</td>
                <td>{{ task.details }}</td>
                <td>{{ task.createdAt|date('d/m/Y H:i') }}</td>
                <td>{{ task.deadline|date('d/m/Y H:i') }}</td>
                <td>
                    <a href="{{ path('app_task_show', {'id': task.id}) }}">Voir</a>
                    <a href="{{ path('app_task_edit', {'id': task.id}) }}">Modifier</a>
                </td>
                <td>
                    {% if task.completed %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="checkChecked" checked>
                            <label class="form-check-label" for="checkChecked">
                                Checked checkbox
                            </label>
                        </div>
                        {% else %}
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="" id="checkDefault">
                                <label class="form-check-label" for="checkDefault">
                                    Default checkbox
                                </label>
                            </div>
                    {% endif %}


            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucune tache trouvée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
