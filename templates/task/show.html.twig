{% extends 'base.html.twig' %}

{% block title %}Tâche : {{ task.title }}{% endblock %}

{% block body %}
    <h1>Tâche : {{ task.title }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ task.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ task.title }}</td>
            </tr>
            <tr>
                <th>Détails</th>
                <td>{{ task.details }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_task_index') }}">Liste des tâches</a>

    <a href="{{ path('app_task_edit', {'id': task.id}) }}">Modifier</a>

    {{ include('task/_delete_form.html.twig') }}
{% endblock %}
